# Copy to .env.local for local development (never commit real values).
# Origin of the API. Leave empty to call the same origin (the Vite dev server proxies /v1, /healthz, /readyz).
VITE_API_BASE_URL=
# Dev-server only (not bundled): where Vite proxies API calls.
API_PROXY_TARGET=http://127.0.0.1:3000
