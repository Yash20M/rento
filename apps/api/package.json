{
  "name": "@rento/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "dev": "pnpm build && concurrently -k -n tsc,api \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --env-file-if-exists=../../.env dist/main.js\"",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:api": "pnpm build && vitest run --project api",
    "cli": "pnpm build && node --env-file-if-exists=../../.env dist/cli/main.js",
    "migrate": "pnpm build && node --env-file-if-exists=../../.env dist/db/migrate-cli.js",
    "test:db": "vitest run --project db",
    "db:codegen": "node --env-file-if-exists=../../.env node_modules/kysely-codegen/dist/cli/bin.js",
    "db:codegen:verify": "node --env-file-if-exists=../../.env node_modules/kysely-codegen/dist/cli/bin.js --verify",
    "test:concurrency": "vitest run --project concurrency"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@node-rs/argon2": "^2.2.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "kysely": "^0.29.6",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.2",
    "@rento/config": "workspace:*",
    "@swc/core": "^1.16.13",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.6",
    "kysely-codegen": "^0.20.0",
    "testcontainers": "^12.2.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
