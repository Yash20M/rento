# Copy to .env for local development. Never commit .env or real secrets.
# Later tasks (P1-03, P0-02…) extend this file with their own keys.
NODE_ENV=development
# Local PostGIS from infra/compose.yaml (host port 5433; local-dev-only credentials)
DATABASE_URL=postgres://rento:rento@127.0.0.1:5433/rento
# Mailpit (local mail catcher; UI at http://127.0.0.1:8025)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# SMTP_SECURE=false (true = implicit TLS, usually port 465); SMTP_USER / SMTP_PASSWORD must be set together or not at all
MAIL_FROM=Rento <no-reply@rento.example>
# Base URL for links in emails (the admin dev server; the mobile app opens these links via deep links later)
PUBLIC_WEB_URL=http://localhost:5173
VERIFICATION_TOKEN_TTL_HOURS=24
RESET_TOKEN_TTL_MINUTES=60
# API (apps/api) — all optional except DATABASE_URL
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DB_POOL_MAX=10
# Auth (apps/api). JWT_SECRET must be ≥ 32 random characters; the value below is a LOCAL-DEV PLACEHOLDER.
# Generate a real one per environment, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-placeholder-change-me-0123456789abcdef
# Optional: previous secret, verify-only, kept during rotation.
JWT_SECRET_PREVIOUS=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Google sign-in (P2-04): comma-separated OAuth client IDs (Web, Android, iOS). Empty = Google sign-in disabled (404).
GOOGLE_CLIENT_IDS=
# GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs   # only override for tests
# Meta (Facebook) sign-in (P2-05): both or neither. The secret stays on the server; never put it in the mobile app.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# FACEBOOK_GRAPH_URL=https://graph.facebook.com          # append /vNN.N to pin a Graph version
# FACEBOOK_JWKS_URL=https://www.facebook.com/.well-known/oauth/openid/jwks/
# Sign in with Apple (P2-06): comma-separated bundle ID (native) and Services ID (web, optional). Empty = disabled (404).
APPLE_CLIENT_IDS=
# APPLE_JWKS_URL=https://appleid.apple.com/auth/keys
# Linking a sign-in method needs an access token issued at most this many seconds ago (30-900).
FRESH_AUTH_MAX_AGE_SECONDS=300
# Admin invitation links stay valid this many hours (1-720, default 168 = 7 days).
ADMIN_INVITATION_TTL_HOURS=168
# How long the admin permission cache lives per user (0 = off). Changes made through the API apply immediately anyway.
PERMISSION_CACHE_TTL_SECONDS=30
# Nearby-drawer search (README §10.3 defaults): radius in meters, how many drawers are suggested.
DISCOVERY_RADIUS_METERS=5000
DISCOVERY_MAX_RESULTS=3

# Bookings (README section 9). Refund tiers are PLACEHOLDERS until the owner answers Q-5: minutes-before-start:percent.
HOLD_MINUTES=10
BOOKING_MIN_LEAD_MINUTES=15
BOOKING_MAX_ADVANCE_DAYS=90
REFUND_TIERS=1440:100,120:50,0:0
PICKUP_EARLY_MINUTES=15
NO_SHOW_GRACE_MINUTES=30
# Background sweeps (expire holds, overdue, no-show, outbox). 0 = off.
JOBS_INTERVAL_SECONDS=30
# Browsers allowed to call the API from another origin (comma separated origins, no paths). Empty = none.
# Flutter web demo: http://localhost:5555. The admin panel session cookie also needs the admin origin here when it is served from another origin or behind a proxy.
CORS_ALLOWED_ORIGINS=
# fake = in-process demo gateway (no keys needed). razorpay = real gateway: set the three keys below (task P4-01).
PAYMENT_PROVIDER=fake
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Reminder email this many minutes before a confirmed booking starts. 0 = none.
REMINDER_MINUTES=60

# Owner Super Admin for LOCAL demos: the demo seed creates (or signs in) this account and makes it Super Admin.
# Put real values in your own untracked .env — never commit a password. Leave empty to skip.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Request limits and sign-in lockout (per instance, in memory). Defaults shown; RATE_LIMIT_ENABLED=false switches them off.
RATE_LIMIT_ENABLED=true
AUTH_RATE_PER_IP=60
AUTH_RATE_PER_ACCOUNT=10
BOOKING_RATE_PER_USER=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Two-step verification (P4-05). true = every administrator must prove an authenticator-app code per session; the
# sensitive actions (roles, admins, refunds) also need a code at most STEP_UP_MAX_AGE_SECONDS old. Switch on before launch.
ADMIN_MFA_REQUIRED=false
STEP_UP_MAX_AGE_SECONDS=600
# Key that encrypts the stored authenticator secrets (>= 32 chars). Empty = derived from JWT_SECRET (so rotating the
# JWT secret then needs this set first, or people re-enrol).
MFA_ENCRYPTION_KEY=
MFA_ISSUER=Rento
